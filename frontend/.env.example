# Copy to .env.local for local overrides, or set in the Vercel dashboard.
#
# Leave EMPTY for local development: requests then go to a relative /api path
# and vite.config.ts proxies them to 127.0.0.1:8000.
#
# Set to the backend origin for production builds (no trailing slash, no /api):
#   VITE_API_BASE_URL=https://resume-tailor-api.onrender.com
VITE_API_BASE_URL=
