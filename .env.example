# ─────────────────────────────────────────────────────────────
#  Copy to .env and fill in real values. NEVER commit .env
# ─────────────────────────────────────────────────────────────

# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Security ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database (Neon free tier: https://neon.tech) ---
# Format: postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/jobagent?sslmode=require

# --- LLM provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.0-flash

# --- File storage ---
# local  → files written to backend/uploads (dev only, not persistent in prod)
# s3     → Cloudflare R2 or any S3-compatible bucket
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
