# ─────────────────────────────────────────────────────────────
#  Copy to .env and fill in real values. NEVER commit .env
# ─────────────────────────────────────────────────────────────

# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Security ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database (Neon free tier: https://neon.tech) ---
# Format: postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/jobagent?sslmode=require

# --- Email (verification) ---
# console → the verification link is written to the log, nothing is sent.
#           Use this for development; no mail account needed.
# brevo   → real delivery. Sign up at https://brevo.com (300/day free),
#           verify your sender address under Senders, then create an API key
#           under SMTP & API. No domain purchase required to verify a single
#           address, though deliverability is better with one.
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Resume Tailor

# Public URL of the frontend. No trailing slash.
FRONTEND_URL=http://localhost:5173

# Codes are typed in straight away, so minutes rather than hours. A short
# window plus the attempt cap is what makes six digits safe.
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5
EMAIL_RESEND_COOLDOWN_SECONDS=60

# --- Reminders (daily digest) ---
# Shared secret for POST /api/v1/internal/reminders/run. Empty disables the
# endpoint entirely rather than leaving it open. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match the CRON_SECRET repository secret in GitHub Actions.
CRON_SECRET=
REMINDER_DEADLINE_DAYS=3
REMINDER_COOLDOWN_DAYS=7

# --- LLM provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-flash-latest

# --- File storage ---
# local → files written to backend/uploads. Development only: container
#         filesystems are wiped on redeploy, so uploads would disappear.
# s3    → Cloudflare R2, or any S3-compatible bucket. Required in production.
STORAGE_BACKEND=local

# Cloudflare R2: create a bucket, then an API token with Object Read & Write.
# The endpoint is https://<account-id>.r2.cloudflarestorage.com (no bucket name).
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Docs ---
# /docs and /redoc are always on outside production. Set true to expose them
# on a production deployment as well.
ENABLE_DOCS=false
